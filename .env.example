# Every operational value the app uses is listed here, with its default.
# Nothing tunable is hard-coded: config.py is the only module that reads the
# environment, so this file is the complete surface.
#
# The ontology itself (axes, GEMS-9 dimensions, the adjective vocabulary and its
# mapping, the Discogs taxonomy) is deliberately NOT here — it lives in
# moodlib/ontology.py, because changing it must bump ONTOLOGY_VERSION so stale
# rows get re-tagged, which a .env edit cannot do.

# --- library ---------------------------------------------------------------
LIBRARY_PATH=/path/to/your/Music
AUDIO_EXTENSIONS=.m4a,.mp3,.mp4,.flac,.aiff,.wav
SCAN_WORKERS=24
# Abort a scan that would mark more than this % of known tracks missing.
# The usual cause is an unmounted NAS; a scan that "successfully" marks 23,000
# tracks gone is indistinguishable from a real library wipe.
SCAN_MISSING_ABORT_PCT=10

# --- llm endpoint ----------------------------------------------------------
# A self-hosted vLLM rarely listens on 80, so set LLM_PORT — omitting it is
# a silent connection timeout rather than a clear error.
LLM_URL=http://your-llm-host
LLM_PORT=8888
LLM_API_PATH=/v1
# Leave LLM_MODEL empty to discover it from /v1/models on first use.
LLM_MODEL=
LLM_API_KEY=

# --- llm behaviour ---------------------------------------------------------
LLM_TEMPERATURE=0.3
# Ceiling for one-off calls (query translation). Tagging sizes its own
# budget from the batch and ignores this.
LLM_MAX_TOKENS=2000
# A 20-track batch measures ~80s; 240 fails a hung request without
# tying up a worker for the whole retry chain.
LLM_TIMEOUT=240
LLM_MAX_RETRIES=3

# --- tagging ---------------------------------------------------------------
# Measured on this endpoint (tracks/s for the whole run, not per request):
#   batch 20, max_tokens 8000,  4 concurrent   0.19   <- the obvious config
#   batch 10, max_tokens 2600, 16 concurrent   1.08
#   batch 10, max_tokens 2600, 28 concurrent   1.17   <- diminishing
# Bigger batches are WORSE: vLLM schedules against the reserved output budget,
# so a large max_tokens starves concurrency. The budget is derived from
# TAG_BATCH_SIZE x TAG_TOKENS_PER_TRACK, so changing the batch size stays safe.
TAG_BATCH_SIZE=10
TAG_CONCURRENCY=20
TAG_TOKENS_PER_TRACK=220

# --- scoring ---------------------------------------------------------------
SCORE_AXIS_WEIGHT=1.0
SCORE_GEMS_WEIGHT=1.0
SCORE_VOCAB_WEIGHT=0.15
# Score multiplier for a confidence-0 (pure genre inference) track. Confidence 2
# scores 1.0. Guessed tracks still compete, just from behind.
SCORE_CONFIDENCE_FLOOR=0.75

# --- playlist --------------------------------------------------------------
PLAYLIST_SIZE=40
MAX_PER_ARTIST=2
MIN_CONFIDENCE=0
# Sample from this multiple of the playlist size, so the same mood asked twice
# returns a different (equally good) playlist rather than an identical one.
PLAYLIST_POOL_FACTOR=3.0
# Rewrite the library root in generated .m3u8 files — for the eventual server
# deployment, where the same files sit under a different mount point.
M3U_PATH_PREFIX=

# --- paths -----------------------------------------------------------------
DATA_DIR=./data
DB_PATH=./data/mood.sqlite3
FFPROBE_BIN=ffprobe
